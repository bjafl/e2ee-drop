# Postgres
POSTGRES_USER=e2eedrop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=e2eedrop
# Host-facing Postgres URL: used by host-side tooling only (pnpm --filter db,
# prisma, pnpm -r test), not by `docker compose up`. The api/migrate/cleanup
# containers build their own compose-internal URL from POSTGRES_USER/
# POSTGRES_PASSWORD/POSTGRES_DB against the `postgres` service directly (see
# docker-compose.yml), so editing this line has no effect on the containers.
# Uses `localhost` because that's how the compose-published Postgres port
# (127.0.0.1:5432, see docker-compose.yml) is reachable from the host; still
# keep the password identical to POSTGRES_PASSWORD.
DATABASE_URL=postgresql://e2eedrop:change-me@localhost:5432/e2eedrop

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too
# Not used by `docker compose up`: the api/cleanup containers hardcode
# http://minio:9000 (the compose-internal MinIO hostname) directly in
# docker-compose.yml, so editing this line has no effect on the containers.
# This only matters for host-side tooling that talks to MinIO directly — the
# compose file publishes no host port for `minio`, so that means a separate,
# standalone MinIO instance, not the one `docker compose up` starts.
MINIO_ENDPOINT=http://minio:9000
# Public endpoint: embedded in presigned upload/download URLs handed to browsers.
# Must be browser-reachable; the web container proxies /s3/ to MinIO. Keep the host:port
# in sync with how users reach the web service (WEB_PORT below).
MINIO_PUBLIC_ENDPOINT=http://localhost:8080/s3
MINIO_REGION=us-east-1
MINIO_BUCKET=e2ee-drop
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-too

# API
PORT=3000
MAX_FILE_SIZE_BYTES=524288000
LINK_EXPIRY_HOURS=24
DROP_RETENTION_DAYS_DEFAULT=1
DROP_RETENTION_DAYS_MAX=7
# Retention days for audit log entries.
AUDIT_RETENTION_DAYS=30
# Words in a link's verification phrase. Minimum 4 (256^4 ≈ 4.3 billion
# combinations) — see README for the collision-probability reasoning.
CODEWORD_WORD_COUNT=4
SESSION_SECRET=change-me-to-a-random-64-char-string
APP_SECRET_KEY=change-me-to-another-random-32-byte-string
ALLOW_REGISTRATION=true
DEFAULT_STORAGE_QUOTA_BYTES=5368709120
APP_URL=http://localhost:8080
# Reverse-proxy hops in front of the API trusted for X-Forwarded-For (client IP for rate limiting).
# 1 = shipped web/nginx only; set 2 if you put your own reverse proxy (Caddy, Traefik, ...) in front of web.
TRUST_PROXY_HOPS=1

# SMTP (optional — password-reset email is unavailable until set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=e2ee-drop <no-reply@example.com>

# Web
# Host port the web container (SPA + /api + /s3 proxy) is published on.
WEB_PORT=8080
