generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String    @id @default(cuid())
  email                     String    @unique
  emailVerified             Boolean   @default(false)
  username                  String    @unique
  name                      String
  passwordHash              String
  passwordSalt              String
  passwordWrappedPrivateKey String
  recoveryWrappedPrivateKey String
  publicKey                 String
  totpSecretEncrypted       String?
  totpEnabled               Boolean   @default(false)
  // BigInt, not Int: Int is Postgres INTEGER (32-bit, max ~2.1GB), which
  // cannot hold DEFAULT_STORAGE_QUOTA_BYTES's own default of 5GB (see
  // apps/api/src/env.ts) — every registration with the default config
  // would overflow this column and 500. See migration
  // 20260925044121_storage_bytes_bigint.
  storageQuotaBytes         BigInt
  storageUsedBytes          BigInt    @default(0)
  createdAt                 DateTime  @default(now())

  links               Link[]
  sentDrops           Drop[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Contact {
  id            String   @id @default(cuid())
  userId        String
  contactUserId String
  status        String   @default("pending")
  createdAt     DateTime @default(now())

  @@unique([userId, contactUserId])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Link {
  id                 String    @id @default(cuid())
  ownerId            String?
  owner              User?     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  slug               String
  mode               String
  visibility         String    @default("public")
  recipientPublicKey String
  codewordLocale     String    @default("en")
  retentionDays      Int?
  isDefault          Boolean   @default(false)
  createdAt          DateTime  @default(now())
  expiresAt          DateTime?
  revokedAt          DateTime?
  drops              Drop[]

  @@unique([ownerId, slug])
  @@index([slug])
}

model Drop {
  id              String   @id @default(cuid())
  linkId          String
  link            Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  senderPublicKey String
  senderUserId    String?
  senderUser      User?    @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  s3Key           String
  nonce           String
  fileName        String
  fileSize        Int
  mimeType        String
  contentMD5      String
  message         String?
  status          String   @default("uploading")
  createdAt       DateTime @default(now())

  @@index([linkId])
}
