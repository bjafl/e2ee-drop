generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Link {
  id                 String    @id @default(cuid())
  ownerId            String?
  slug               String
  mode               String
  visibility         String    @default("public")
  recipientPublicKey String
  codewordLocale     String    @default("en")
  retentionDays      Int?
  isDefault          Boolean   @default(false)
  createdAt          DateTime  @default(now())
  expiresAt          DateTime?
  revokedAt          DateTime?
  drops              Drop[]

  @@unique([ownerId, slug])
  @@index([slug])
}

model Drop {
  id              String   @id @default(cuid())
  linkId          String
  link            Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  senderPublicKey String
  senderUserId    String?
  s3Key           String
  nonce           String
  fileName        String
  fileSize        Int
  mimeType        String
  contentMD5      String
  message         String?
  status          String   @default("uploading")
  createdAt       DateTime @default(now())

  @@index([linkId])
}
