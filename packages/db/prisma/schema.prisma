generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String    @id @default(cuid())
  email                     String    @unique
  emailVerified             Boolean   @default(false)
  username                  String    @unique
  name                      String
  passwordHash              String
  passwordSalt              String
  passwordWrappedPrivateKey String
  recoveryWrappedPrivateKey String
  publicKey                 String
  totpSecretEncrypted       String?
  totpEnabled               Boolean   @default(false)
  // BigInt, not Int: Int is Postgres INTEGER (32-bit, max ~2.1GB), which
  // cannot hold DEFAULT_STORAGE_QUOTA_BYTES's own default of 5GB (see
  // apps/api/src/env.ts) — every registration with the default config
  // would overflow this column and 500. See migration
  // 20260925044121_storage_bytes_bigint.
  storageQuotaBytes         BigInt
  storageUsedBytes          BigInt    @default(0)
  createdAt                 DateTime  @default(now())

  showEmailOnPublicProfile Boolean @default(false)

  links               Link[]
  sentDrops           Drop[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
}

model Session {
  /// Always supplied explicitly by createSession() (apps/api/src/lib/sessions.ts)
  /// as 32 CSPRNG bytes, base64url-encoded; the cuid() default is not relied on.
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Contact {
  id            String   @id @default(cuid())
  userId        String
  contactUserId String
  status        String   @default("pending")
  createdAt     DateTime @default(now())

  @@unique([userId, contactUserId])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Link {
  id                 String    @id @default(cuid())
  ownerId            String?
  owner              User?     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Globally unique, not per-owner: every link — anonymous or owned — is
  // resolved by slug alone (/d/<slug>, GET /api/links/:slug), so two links
  // sharing a slug would make lookups ambiguous. A per-(ownerId, slug) unique
  // did not prevent this, because Postgres treats NULL ownerIds (anonymous
  // links) as distinct, and a username (= default link slug) can equal an
  // anonymous link's random slug. See migration 20260925055712_link_slug_globally_unique.
  slug               String    @unique
  mode               String
  visibility         String    @default("public")
  recipientPublicKey String?
  codewordLocale     String    @default("en")
  retentionDays      Int
  isDefault          Boolean   @default(false)
  createdAt          DateTime  @default(now())
  expiresAt          DateTime?
  revokedAt          DateTime?
  drops              Drop[]

  ownerNote String?

  // Replaces the old @@unique([ownerId, slug]) index's role in serving
  // owner-scoped queries (e.g. cascadeDeleteUserLinks' findMany by ownerId).
  @@index([ownerId])
}

model Drop {
  id              String   @id @default(cuid())
  linkId          String
  link            Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  senderPublicKey String
  senderUserId    String?
  senderUser      User?    @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  s3Key        String
  archiveNonce String
  contentMD5   String

  encryptedMessage  String?
  messageNonce      String?
  messageRevealedAt DateTime?

  encryptedMetadata String
  metadataNonce     String
  fileSize          Int

  // fileUploadStatus: "uploading" | "complete" — internal transfer bookkeeping, mirrors the old
  // Drop.status's role in uploads.ts's CAS logic. A third value, "reserved", is reserved for
  // spec 2's eager pre-upload tracking (not written or read anywhere in this plan or plan 2).
  fileUploadStatus     String  @default("uploading")
  // Opaque per-sender-network tag (keyed hash of the sender's IPv4 address or
  // IPv6 /64, see apps/api/src/lib/senderKey.ts), set only while an OWNED
  // link's drop is an in-flight quota reservation, so upload-url can cap how
  // much of one owner's quota a single sender may hold in reservations (see
  // assertWithinSenderShare in apps/api/src/lib/quota.ts). Cleared when the
  // drop completes; never included in any API response.
  reservationSenderKey String?

  // deliveryStatus: "sender_opened" | "sent" | "receiver_opened" | "partial_delivery" | "delivered"
  // messageEnvelopeStatus / fileEnvelopeStatus: "sealed" | "delivery_failed" | "delivered" | "shredded"
  // Full state-machine semantics and cross-drop aggregation belong to spec 2; this plan and plan 2
  // only read/write the two envelope-status fields (never "partial_delivery"/"delivered" on
  // deliveryStatus directly — plan 2 derives and writes those from the two envelope statuses).
  deliveryStatus        String @default("sender_opened")
  messageEnvelopeStatus String @default("sealed")
  fileEnvelopeStatus    String @default("sealed")

  contentDeletedAt DateTime?

  createdAt DateTime @default(now())

  @@index([linkId])
}
